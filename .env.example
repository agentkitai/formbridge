# FormBridge Environment Variables
# Copy this file to .env and fill in your values.

# Webhook signing secret for HMAC-SHA256 signatures.
# Required for secure webhook delivery. Generate with: openssl rand -hex 32
FORMBRIDGE_WEBHOOK_SECRET=

# Server port (default: 3000)
PORT=3000

# Webhook URL for sending reviewer notifications when submissions need approval.
# If not set, reviewer notifications are silently skipped.
FORMBRIDGE_REVIEWER_WEBHOOK_URL=

# ── Durable storage backend ──
# Selects the storage backend for submissions, events, and the delivery outbox.
# Values: memory | sqlite | postgres (default: memory).
FORMBRIDGE_STORAGE=memory

# PostgreSQL connection string. Required when FORMBRIDGE_STORAGE=postgres.
# Example: postgresql://user:pass@localhost:5432/formbridge
DATABASE_URL=

# SQLite database file path. Used when FORMBRIDGE_STORAGE=sqlite.
# Defaults to :memory: (non-durable) when unset. Example: ./data/formbridge.db
SQLITE_PATH=

# ── Webhook SSRF escape hatch (DEV/TEST ONLY) ──
# Permit loopback / private-range webhook destinations (127.0.0.1, ::1, 10.x,
# 172.16-31.x, 192.168.x, localhost) so local integrations can deliver to a
# service on the same host. Cloud metadata (169.254.169.254 / metadata.*) and
# non-HTTP(S) schemes stay BLOCKED even when this is on. Default off, and
# HARD-REFUSED when NODE_ENV=production (it can never take effect in prod).
# Values: 1 | true | yes to enable.
FORMBRIDGE_ALLOW_PRIVATE_WEBHOOKS=
